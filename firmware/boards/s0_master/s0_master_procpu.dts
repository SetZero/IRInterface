/*
 * S0 Master 0.1 - ESP32-S3-WROOM-1 with RS-485 downlink to the IR Interface
 * KiCad project "s0_master"
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;

#include <espressif/esp32s3/esp32s3_wroom_n4r2.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <espressif/partitions_0x0_amp_4M.dtsi>
#include "s0_master-pinctrl.dtsi"

/ {
	model = "S0 Master 0.1 PROCPU";
	compatible = "espressif,esp32s3";

	aliases {
		uart-0 = &uart0;
		rs485-uart = &uart1;
		watchdog0 = &wdt0;
		sw0 = &button0;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	/* second Wi-Fi interface, used for the setup access point */
	wifi_ap: wifi_ap {
		compatible = "espressif,esp32-wifi";
		status = "okay";
	};

	buttons {
		compatible = "gpio-keys";

		/* SW2; also the boot strapping pin */
		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

/* USB D+/D- are not routed: the USB-C connector only supplies power. */
&usb_serial {
	status = "disabled";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/*
 * RS-485 downlink (THVD1424, hard-wired full duplex, both terminations on).
 *
 * With a straight-through RJ45 cable the differential pairs arrive with
 * swapped polarity on both boards (Y/Z of one side land on B/A of the
 * other). Each board therefore inverts its own transmitter.
 */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	tx-invert;
};

&gpio0 {
	status = "okay";

	/* THVD1424 DE: point-to-point full duplex, driver always on */
	rs485-de {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-high;
	};

	/* THVD1424 /RE: receiver always on */
	rs485-re {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	/* THVD1424 SLR: high = slew-rate limited (up to 500 kbit/s) */
	rs485-slr {
		gpio-hog;
		gpios = <21 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&gpio1 {
	status = "okay";
};

&timer0 {
	status = "disabled";
};

&timer1 {
	status = "disabled";
};

&timer2 {
	status = "disabled";
};

&timer3 {
	status = "disabled";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
