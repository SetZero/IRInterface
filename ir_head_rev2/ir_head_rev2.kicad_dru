(version 1)
# JLCPCB manufacturing limits, FR-4, 1 oz copper, 4 copper layers.
# Source: jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-14.
#
# Held by the board setup already, with a tighter value, so not repeated here:
#   track width and spacing   JLCPCB 0.09 mm   board setup 0.20 mm
#   copper to board edge      JLCPCB 0.20 mm   board setup 0.50 mm
#   via to track              JLCPCB 0.20 mm   board setup 0.20 mm (clearance)
#   unplated hole to track    JLCPCB 0.20 mm   board setup 0.25 mm (hole clearance)

(rule "JLCPCB via: hole 0.15, pad 0.25, ring 0.15 minimum"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.15mm))
  (constraint via_diameter (min 0.25mm))
  (constraint annular_width (min 0.15mm)))

(rule "JLCPCB plated pad hole: 0.15, ring 0.15 minimum"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_size (min 0.15mm))
  (constraint annular_width (min 0.15mm)))

(rule "JLCPCB unplated hole: 0.5 minimum"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.5mm)))

(rule "JLCPCB via holes: 0.2 apart"
  (constraint hole_to_hole (min 0.2mm)))

(rule "JLCPCB pad holes: 0.45 apart"
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

(rule "JLCPCB plated pad hole to other copper: 0.28"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))

(rule "JLCPCB silkscreen text: 1.0 high, 0.15 line"
  (condition "A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen'")
  (constraint text_height (min 1.0mm))
  (constraint text_thickness (min 0.15mm)))

(rule "JLCPCB silkscreen to pad: 0.15"
  (condition "(A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen') && B.Type == 'Pad'")
  (constraint silk_clearance (min 0.15mm)))
